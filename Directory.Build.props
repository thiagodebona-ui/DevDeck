<Project>
  <PropertyGroup>
    <!-- net10.0 (the current LTS) with no -windows suffix: this is the whole point of the V3 tree. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- C# 14, the language .NET 10 ships with. Pinned rather than latest, so the language does
         not change underneath the code when a newer SDK is installed. -->
    <LangVersion>14</LangVersion>
    <!-- The single source of truth for the version, as in V2. -->
    <Version>1.2.3</Version>
    <Product>DevDeck</Product>
    <!-- Keep the build warning-free: nullable problems fail rather than accumulate. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!-- Symbols inside the DLL rather than beside it: a single-file publish would otherwise leave
         a loose .pdb per project, and dropping them would cost the line numbers in a crash. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
