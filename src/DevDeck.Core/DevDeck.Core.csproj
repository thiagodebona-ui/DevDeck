<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- No UI package may ever be referenced here. Everything in this project has to compile and
         run on all three platforms; anything that cannot belongs in DevDeck.App or behind a
         platform check. -->
    <AssemblyName>DevDeck.Core</AssemblyName>
    <RootNamespace>DevDeck.Core</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- The changelog travels inside the build, so the Changelog page can say what this version
         brought without asking the network. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>
</Project>
