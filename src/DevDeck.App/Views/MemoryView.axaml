<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:DevDeck.App"
             xmlns:loc="using:DevDeck.App.Localisation"
             xmlns:vm="using:DevDeck.App.ViewModels"
             xmlns:views="using:DevDeck.App.Views"
             x:Class="DevDeck.App.Views.MemoryView"
             x:DataType="vm:MemoryViewModel">

  <UserControl.Styles>

    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource SteelRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SteelHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Steel}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style Selector="Button.go">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.go:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
    </Style>

    <Style Selector="TextBlock.stat">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style Selector="TextBlock.figure">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <!-- The bars are the one bold thing on the page, so pressure reads at a glance from across the
         desk. The accent is normal load; amber and red are the usual bands above it. -->
    <Style Selector="ProgressBar.fill /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="ProgressBar.fill.high /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource Warn}" />
    </Style>

    <Style Selector="ProgressBar.fill.critical /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource Bad}" />
    </Style>

    <Style Selector="views|Gauge.memory">
      <Setter Property="Fill" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="views|Gauge.memory.high">
      <Setter Property="Fill" Value="{DynamicResource Warn}" />
    </Style>

    <Style Selector="views|Gauge.memory.critical">
      <Setter Property="Fill" Value="{DynamicResource Bad}" />
    </Style>

    <Style Selector="views|Gauge.cpu">
      <Setter Property="Fill" Value="{DynamicResource Good}" />
    </Style>

    <Style Selector="views|Gauge.cpu.high">
      <Setter Property="Fill" Value="{DynamicResource Warn}" />
    </Style>

    <Style Selector="views|Gauge.cpu.critical">
      <Setter Property="Fill" Value="{DynamicResource Bad}" />
    </Style>

    <Style Selector="views|Gauge.disk">
      <Setter Property="Fill" Value="{DynamicResource SynKeyword}" />
    </Style>

    <Style Selector="views|Gauge.disk.high">
      <Setter Property="Fill" Value="{DynamicResource Warn}" />
    </Style>

    <Style Selector="views|Gauge.disk.critical">
      <Setter Property="Fill" Value="{DynamicResource Bad}" />
    </Style>

    <Style Selector="views|Gauge.gpu">
      <Setter Property="Fill" Value="{DynamicResource SynString}" />
    </Style>

    <Style Selector="views|Gauge.gpu.high">
      <Setter Property="Fill" Value="{DynamicResource Warn}" />
    </Style>

    <Style Selector="views|Gauge.gpu.critical">
      <Setter Property="Fill" Value="{DynamicResource Bad}" />
    </Style>

    <!-- End task on a process row: quiet until the row is hovered, because twelve red buttons
         down the side of a readout would make it look like a list of problems. -->
    <Style Selector="Button.end">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.row:pointerover Button.end">
      <Setter Property="Foreground" Value="{DynamicResource Bad}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <!-- One gauge and its figures, a quarter of the card each, so the four spread with the
         window. The figures wrap rather than being cut off when the window is narrow. -->
    <Style Selector="Grid.reading">
      <Setter Property="Margin" Value="0,6,12,6" />
    </Style>

    <Style Selector="Grid.reading TextBlock.stat, Grid.reading TextBlock.figure">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A process row. One line, so the eye runs straight across it to the numbers, and the whole
         row lights on hover because there is nothing else joining the two ends. -->
    <Style Selector="Border.row">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Steel}" />
    </Style>

    <!-- The initial, in its own disc. Small and quiet: it is a landmark for the eye coming back
         to the list, not a piece of information. -->
    <Style Selector="Border.disc">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Background" Value="{DynamicResource Track}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The share bar, in a column of its own. It used to be drawn across the bottom of the row,
         where it ran straight through "pid 24780" and read as a strikethrough. -->
    <Style Selector="ProgressBar.share">
      <!-- Fluent gives a ProgressBar a 200px MinWidth, which is how the bar came to overhang its
           own column and draw itself through the memory figure to its left. -->
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ProgressBar.share /template/ Border#PART_Indicator">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="TextBlock.num">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A process using no processor at all is the normal case, so its 0.0% is drawn back to stop
         a column of zeroes competing with the two or three figures that mean something. -->
    <Style Selector="TextBlock.num.idle">
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style Selector="TextBlock.num.hot">
      <Setter Property="Foreground" Value="{DynamicResource Warn}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.pid">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Column heads. Faint and small: they are read once and then never again. -->
    <Style Selector="TextBlock.head">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="TextBlock.outcome">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Good}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.outcome.bad">
      <Setter Property="Foreground" Value="{DynamicResource Bad}" />
    </Style>

    <!-- Waiting and running are not results, so they are not coloured like one. -->
    <Style Selector="TextBlock.outcome.pending">
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style Selector="TextBlock.outcome.working">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- The step being worked on is lifted out of the list while it runs, so a long one is
         obviously the thing holding everything up. -->
    <Style Selector="Border.card.running">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource Steel}" />
    </Style>

    <!-- Same chasing arc as the widget uses, at row size. -->
    <Style Selector="Ellipse.spinner">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stroke" Value="{DynamicResource Accent}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeDashArray" Value="3.2,3.2" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>

    <Style Selector="Ellipse.spinner.turning">
      <Style.Animations>
        <Animation Duration="0:0:1.1" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The gauges' columns, by the width of their card; see Readings. In styles rather than on
         the grid, because a value written on the element outranks any style. -->
    <Style Selector="UniformGrid#ReadingGrid">
      <Setter Property="Columns" Value="4" />
      <Setter Property="RowSpacing" Value="14" />
    </Style>

    <ContainerQuery Name="Readings" Query="max-width:1000">
      <Style Selector="UniformGrid#ReadingGrid">
        <Setter Property="Columns" Value="2" />
      </Style>
    </ContainerQuery>

    <ContainerQuery Name="Readings" Query="max-width:520">
      <Style Selector="UniformGrid#ReadingGrid">
        <Setter Property="Columns" Value="1" />
      </Style>
    </ContainerQuery>


    <!-- A preset: a button that reads as a choice card, with what it does under its name. The
         one matching the current ticks is outlined, so hand-ticking visibly leaves the presets. -->
    <Style Selector="Button.preset">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinWidth" Value="190" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <Style Selector="Button.preset.on">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource Steel}" />
    </Style>

    <Style Selector="Button.preset.on /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="Button.preset:pressed, Button.go:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!-- A step or a disk target: one row of a shared card rather than a card each, so ten steps
         read as one list instead of ten boxes. -->
    <Style Selector="Border.item">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.item:pointerover">
      <Setter Property="Background" Value="{DynamicResource Steel}" />
    </Style>

    <Style Selector="Border.item.running">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource Steel}" />
    </Style>

    <!-- Small pill beside a title: "administrator", "spared". -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource Track}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,1,8,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.badge.count TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.badge Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource Warn}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource SteelRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,2,4,2" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <Style Selector="Button.chipClose">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style Selector="Button.chipClose:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Bad}" />
    </Style>

    <!-- Spare on a process row: quiet like End task until hovered, and lit once it is on. -->
    <Style Selector="Border.row:pointerover Button.spare">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <Style Selector="Button.spare.on">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="Path.sparedMark">
      <Setter Property="Stroke" Value="{DynamicResource Accent}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Margin" Value="6,1,0,0" />
    </Style>

    <!-- The history strip: one bar per clean, bottom-aligned, newest on the right. -->
    <Style Selector="Border.bar">
      <Setter Property="Width" Value="7" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Background" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style Selector="Border.bar.good">
      <Setter Property="Background" Value="{DynamicResource Good}" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <Style Selector="TextBlock.size">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="12,2,0,0" />
    </Style>

    <Style Selector="TextBlock.size.empty">
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource CodeBg}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="FormatString" Value="0" />
      <Setter Property="Width" Value="110" />
    </Style>


  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0" Padding="22,16,22,14"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{loc:T MemoryMemoryAndProcessor}" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding WidgetCommand}">
          <StackPanel Classes="iconLabel">
            <Path Classes="icon" Data="{x:Static app:Icons.Gauge}" />
            <TextBlock Text="{Binding WidgetLabel}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding RefreshCommand}">
          <StackPanel Classes="iconLabel">
            <Path Classes="icon" Data="{x:Static app:Icons.Refresh}" />
            <TextBlock Text="{loc:T Refresh}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <!-- Stretched to the window like every other page. The process rows give their slack to
           the share bar, so a wide window makes a longer chart rather than a gap. -->
      <StackPanel Margin="22,20,22,20" Spacing="18"
                  HorizontalAlignment="Stretch">

        <!-- The two readings as gauges, side by side: they are read together, and stacking them
             makes the second look like a detail of the first. Same control the widget's dial is
             built from, so a ring means the same thing in both places. -->
        <!-- Four across where there is room, two by two where there is not, and one per line on
             the narrowest window (the ContainerQuery at the top): side by side at any width, each
             text column shrank until it broke a word per line. -->
        <Border Classes="card" Padding="20,12"
                Container.Name="Readings" Container.Sizing="Width">
          <UniformGrid Name="ReadingGrid">

            <Grid Classes="reading" ColumnDefinitions="Auto,*">
              <Panel Grid.Column="0">
                <views:Gauge Classes="memory"
                             Classes.high="{Binding IsHigh}"
                             Classes.critical="{Binding IsCritical}"
                             Percent="{Binding UsedPercent}"
                             RingSize="112" Thickness="11" />
                <StackPanel Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding UsedPercentText}" FontSize="24" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource Text}" />
                  <TextBlock Classes="stat" Text="{loc:T MemoryMemory}" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
              <TextBlock Classes="figure" Text="{Binding Used}" />
              <TextBlock Classes="stat" Text="{Binding TotalLine}" TextWrapping="Wrap" />
              <TextBlock Classes="stat" Text="{Binding AvailableLine}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <Grid Classes="reading" ColumnDefinitions="Auto,*">
              <Panel Grid.Column="0">
                <views:Gauge Classes="cpu"
                             Classes.high="{Binding IsCpuHigh}"
                             Classes.critical="{Binding IsCpuCritical}"
                             Percent="{Binding CpuPercent}"
                             RingSize="112" Thickness="11" />
                <StackPanel Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CpuPercentText}" FontSize="24" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource Text}" />
                  <TextBlock Classes="stat" Text="{loc:T MemoryProcessor}" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
              <TextBlock Classes="figure" Text="{Binding Cores}" TextWrapping="Wrap" />
              <TextBlock Classes="stat" Text="{loc:T MemoryAcrossAllCores}" TextWrapping="Wrap" />
              <TextBlock Classes="stat" Text="{loc:T MemorySampledEveryTwoSeconds}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <Grid Classes="reading" ColumnDefinitions="Auto,*">
              <Panel Grid.Column="0">
                <views:Gauge Classes="disk"
                             Classes.high="{Binding IsDiskHigh}"
                             Classes.critical="{Binding IsDiskCritical}"
                             Percent="{Binding DiskPercent}"
                             RingSize="112" Thickness="11" />
                <StackPanel Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DiskPercentText}" FontSize="24" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource Text}" />
                  <TextBlock Classes="stat" Text="{loc:T MemoryDisk}" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
              <TextBlock Classes="stat" Text="{loc:T MemoryDiskActive}" TextWrapping="Wrap" />
              <TextBlock Classes="stat" Text="{Binding DiskDetail}" TextWrapping="Wrap" />
              <!-- How full the drive is: used against free, refreshed every five seconds. -->
              <ProgressBar Classes="fill space"
                           Classes.high="{Binding IsDiskSpaceHigh}"
                           Classes.critical="{Binding IsDiskSpaceCritical}"
                           IsVisible="{Binding HasDiskSpace}"
                           Minimum="0" Maximum="100" Value="{Binding DiskSpacePercent}"
                           Height="6" MinHeight="0" MinWidth="0" CornerRadius="3"
                           Margin="0,4,0,1"
                           Background="{DynamicResource Track}"
                           ToolTip.Tip="{Binding DiskSpaceText}" />
              <TextBlock Classes="stat" Text="{Binding DiskSpaceText}" TextWrapping="Wrap"
                         IsVisible="{Binding HasDiskSpace}" />
              </StackPanel>
            </Grid>

            <Grid Classes="reading" ColumnDefinitions="Auto,*">
              <Panel Grid.Column="0">
                <views:Gauge Classes="gpu"
                             Classes.high="{Binding IsGpuHigh}"
                             Classes.critical="{Binding IsGpuCritical}"
                             Percent="{Binding GpuPercent}"
                             RingSize="112" Thickness="11" />
                <StackPanel Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding GpuPercentText}" FontSize="24" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource Text}" />
                  <TextBlock Classes="stat" Text="{loc:T MemoryGpu}" HorizontalAlignment="Center" />
                </StackPanel>
              </Panel>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
              <TextBlock Classes="stat" Text="{Binding GpuDetail}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

          </UniformGrid>
        </Border>

        <!-- Largest processes. A card like everything else on the page, one line per process, and
             a column of bars that turns twelve numbers into a shape you can read without them. -->
        <StackPanel Spacing="10">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="{loc:T MemoryLargestProcesses}"
                       VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" IsChecked="{Binding GroupProcesses}"
                      ToolTip.Tip="{loc:T MemGroupTip}" Content="{loc:T MemGroup}" />
          </Grid>

          <Border Classes="card" Padding="8,10,14,10">
            <StackPanel>

              <!-- The same column definitions as the rows below, so a head sits over what it
                   names. They did not: the header grid was missing the disc's column. -->
              <Grid ColumnDefinitions="Auto,2*,3*,96,64,Auto,Auto" Margin="8,0,0,6">
                <Border Grid.Column="0" Classes="disc" Opacity="0" IsHitTestVisible="False" />
                <TextBlock Grid.Column="1" Classes="head" Text="{loc:T MemoryProcess}" />
                <TextBlock Grid.Column="2" Classes="head" Text="{loc:T MemoryShareOfTheHeaviest}"
                           Margin="16,0,0,0" />
                <TextBlock Grid.Column="3" Classes="head" Text="{loc:T MemoryMemory2}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Classes="head" Text="CPU" TextAlignment="Right" />
                <Button Grid.Column="5" Classes="end" Opacity="0" IsHitTestVisible="False">
                  <StackPanel Classes="iconLabel">
                    <Path Classes="icon" Data="{x:Static app:Icons.Shield}" />
                    <TextBlock Text="{loc:T MemSpared}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="6" Classes="end" Opacity="0" IsHitTestVisible="False">
                  <StackPanel Classes="iconLabel">
                    <Path Classes="icon solid" Data="{x:Static app:Icons.Stop}" />
                    <TextBlock Text="{loc:T RunningKill}" />
                  </StackPanel>
                </Button>
              </Grid>

              <ItemsControl ItemsSource="{Binding Processes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProcessRow">
                    <Border Classes="row" ToolTip.Tip="{Binding Detail}">
                      <Grid ColumnDefinitions="Auto,2*,3*,96,64,Auto,Auto">

                        <Border Grid.Column="0" Classes="disc">
                          <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextMuted}" />
                        </Border>

                        <!-- Name and pid side by side. Stacked, the pid was a second line of text
                             holding the row open and giving the bar something to collide with. The
                             shield between them marks a process no trim touches. -->
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,*" ClipToBounds="True">
                          <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                     Foreground="{DynamicResource Text}"
                                     TextTrimming="CharacterEllipsis" MaxWidth="180"
                                     VerticalAlignment="Center" />
                          <!-- How many copies a grouped row stands for. -->
                          <Border Grid.Column="1" Classes="badge count" IsVisible="{Binding IsGroup}"
                                  Margin="7,0,0,0">
                            <TextBlock Text="{Binding CountText}" />
                          </Border>
                          <Path Grid.Column="2" Classes="icon sparedMark"
                                Data="{x:Static app:Icons.Shield}"
                                IsVisible="{Binding IsSpared}" />
                          <TextBlock Grid.Column="3" Classes="pid" Text="{Binding Pid}"
                                     Margin="8,1,0,0" />
                        </Grid>

                        <!-- The bar takes the slack in the row, so a wider window gives a longer
                             chart rather than a wider gap between the name and its numbers. It
                             sits immediately left of the figure it is drawing. -->
                        <ProgressBar Grid.Column="2" Classes="share"
                                     Minimum="0" Maximum="100" Value="{Binding Bar}"
                                     MinWidth="0" Height="5" CornerRadius="3"
                                     Margin="16,0,18,0"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Background="{DynamicResource Track}"
                                     BorderThickness="0" />

                        <TextBlock Grid.Column="3" Classes="num" Text="{Binding Size}"
                                   Foreground="{DynamicResource Text}" />

                        <TextBlock Grid.Column="4" Classes="num"
                                   Classes.idle="{Binding IsIdle}"
                                   Classes.hot="{Binding IsHot}"
                                   Text="{Binding Cpu}"
                                   Foreground="{DynamicResource TextMuted}" />

                        <!-- Keeps the process out of every trim; pressed again, lets it back in. -->
                        <Button Grid.Column="5" Classes="end spare"
                                Classes.on="{Binding IsSpared}"
                                ToolTip.Tip="{loc:T MemSpareTip}"
                                CommandParameter="{Binding}"
                                Command="{Binding $parent[UserControl].((vm:MemoryViewModel)DataContext).SpareProcessCommand}">
                          <StackPanel Classes="iconLabel">
                            <Path Classes="icon" Data="{x:Static app:Icons.Shield}" />
                            <TextBlock Text="{loc:T MemSpare}" IsVisible="{Binding !IsSpared}" />
                            <TextBlock Text="{loc:T MemSpared}" IsVisible="{Binding IsSpared}" />
                          </StackPanel>
                        </Button>

                        <Button Grid.Column="6" Classes="end"
                                ToolTip.Tip="{loc:T RunningKillTip}"
                                CommandParameter="{Binding}"
                                Command="{Binding $parent[UserControl].((vm:MemoryViewModel)DataContext).EndProcessCommand}">
                          <StackPanel Classes="iconLabel">
                            <Path Classes="icon solid" Data="{x:Static app:Icons.Stop}" />
                            <TextBlock Text="{loc:T RunningKill}" />
                          </StackPanel>
                        </Button>

                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </Border>

        </StackPanel>

        <!-- Clean memory: presets first, because most people want "do the sensible thing" rather
             than ten decisions; the history under them answers "is this doing anything for me". -->
        <StackPanel Spacing="10">

          <TextBlock Classes="section" Text="{loc:T MemCleanTitle}" />

          <Border Classes="card">
            <StackPanel Spacing="10">

              <TextBlock Classes="stat" TextWrapping="Wrap" Text="{loc:T MemCleanIntro}" />

              <WrapPanel>
                <Button Classes="preset" Classes.on="{Binding IsQuick}"
                        Command="{Binding ApplyPresetCommand}" CommandParameter="Quick"
                        ToolTip.Tip="{loc:T MemPresetQuickTip}">
                  <StackPanel Spacing="3">
                    <StackPanel Classes="iconLabel">
                      <Path Classes="icon" Data="{x:Static app:Icons.Bolt}" />
                      <TextBlock Text="{loc:T MemPresetQuick}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Classes="stat" Text="{loc:T MemPresetQuickNote}" />
                  </StackPanel>
                </Button>
                <Button Classes="preset" Classes.on="{Binding IsRecommended}"
                        Command="{Binding ApplyPresetCommand}" CommandParameter="Recommended"
                        ToolTip.Tip="{loc:T MemPresetRecommendedTip}">
                  <StackPanel Spacing="3">
                    <StackPanel Classes="iconLabel">
                      <Path Classes="icon" Data="{x:Static app:Icons.Sparkle}" />
                      <TextBlock Text="{loc:T MemPresetRecommended}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Classes="stat" Text="{loc:T MemPresetRecommendedNote}" />
                  </StackPanel>
                </Button>
                <Button Classes="preset" Classes.on="{Binding IsDeep}"
                        Command="{Binding ApplyPresetCommand}" CommandParameter="Deep"
                        ToolTip.Tip="{loc:T MemPresetDeepTip}">
                  <StackPanel Spacing="3">
                    <StackPanel Classes="iconLabel">
                      <Path Classes="icon" Data="{x:Static app:Icons.Flame}" />
                      <TextBlock Text="{loc:T MemPresetDeep}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Classes="stat" Text="{loc:T MemPresetDeepNote}" />
                  </StackPanel>
                </Button>
              </WrapPanel>

              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="stat" Text="{Binding PresetName}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}" />
                <TextBlock Classes="stat" Text="·" />
                <TextBlock Classes="stat" Text="{Binding TickedSummary}" />
              </StackPanel>

              <!-- Progress through the ticked steps, only while a clean runs. -->
              <ProgressBar Classes="fill" IsVisible="{Binding IsBusy}"
                           Minimum="0" Maximum="100" Value="{Binding CleanProgress}"
                           Height="4" MinHeight="0" MinWidth="0" CornerRadius="2"
                           Background="{DynamicResource Track}" />

              <Border Height="1" Background="{DynamicResource Line}" Margin="0,2" />

              <!-- The last cleans as bars, then the latest and the running total. -->
              <Grid ColumnDefinitions="Auto,*">
                <ItemsControl Grid.Column="0" ItemsSource="{Binding History}"
                              Height="36" VerticalAlignment="Center" Margin="0,0,14,0"
                              IsVisible="{Binding HasHistory}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryBar">
                      <Panel Height="36" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                        <Border Classes="bar" Classes.good="{Binding Good}" Height="{Binding Height}" />
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding LastCleanText}" FontSize="12.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource Text}" />
                  <TextBlock Classes="stat" Text="{Binding HistoryTotalText}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

            </StackPanel>
          </Border>
        </StackPanel>

        <!-- The steps. Every step says what it does before it is ticked, and what it did after it
             ran, because most of them are irreversible-sounding and none of them are obvious. -->
        <StackPanel Spacing="10">

          <!-- The notes under the heading rather than beside it: beside it, a long translation
               grew over the heading on a narrow window. -->
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="{loc:T MemoryCleanupSteps}" />
            <TextBlock Classes="stat" TextWrapping="Wrap"
                       IsVisible="{Binding NeedsElevation}"
                       Foreground="{DynamicResource Warn}"
                       Text="{loc:T MemorySomeTickedStepsNeedAnAdministrator}" />
            <TextBlock Classes="stat" TextWrapping="Wrap"
                       IsVisible="{Binding AdminStepsSkipped}"
                       Foreground="{DynamicResource Warn}"
                       Text="{loc:T MemAdminSkipped}" />
          </StackPanel>

          <Border Classes="card" Padding="6,6">
            <StackPanel Spacing="2">

              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StepToggle">
                    <Border Classes="item" Classes.running="{Binding IsRunning}" Margin="0,0,0,2">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsOn}"
                                    IsEnabled="{Binding IsSupported}"
                                    Content="{Binding Title}" />
                          <Border Grid.Column="1" Classes="badge" IsVisible="{Binding NeedsAdmin}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Path Classes="icon" Data="{x:Static app:Icons.Shield}" />
                              <TextBlock Text="{loc:T MemoryAdministrator}" />
                            </StackPanel>
                          </Border>
                          <!-- Turns while this step is the one running. -->
                          <Ellipse Grid.Column="3" Classes="spinner"
                                   Classes.turning="{Binding IsRunning}"
                                   IsVisible="{Binding IsRunning}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        </Grid>
                        <TextBlock Classes="stat" Margin="28,0,0,0" TextWrapping="Wrap"
                                   Text="{Binding Explain}" />
                        <TextBlock Classes="outcome"
                                   Classes.bad="{Binding OutcomeIsBad}"
                                   Classes.pending="{Binding IsWaiting}"
                                   Classes.working="{Binding IsRunning}"
                                   Margin="28,0,0,0"
                                   IsVisible="{Binding Outcome, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding Outcome}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="{DynamicResource Line}" Margin="10,6" />

              <!-- How the trim behaves, and what it never touches. -->
              <StackPanel Spacing="8" Margin="10,2,10,8">
                <CheckBox IsChecked="{Binding SkipBusy}" ToolTip.Tip="{loc:T MemOptSkipBusyTip}"
                          Content="{loc:T MemOptSkipBusy}" />
                <CheckBox IsChecked="{Binding AllowElevation}" IsVisible="{Binding !IsElevated}"
                          ToolTip.Tip="{loc:T MemOptAllowElevationTip}"
                          Content="{loc:T MemOptAllowElevation}" />

                <TextBlock Classes="stat" Text="{loc:T MemSparedTitle}" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextMuted}" />
                <TextBlock Classes="stat" TextWrapping="Wrap" Text="{loc:T MemSparedNone}"
                           IsVisible="{Binding !HasExcluded}" />
                <ItemsControl ItemsSource="{Binding Excluded}" IsVisible="{Binding HasExcluded}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="chip">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Text}" />
                          <Button Classes="chipClose" ToolTip.Tip="{loc:T MemUnspareTip}"
                                  CommandParameter="{Binding}"
                                  Command="{Binding $parent[UserControl].((vm:MemoryViewModel)DataContext).UnspareCommand}">
                            <Path Classes="icon" Data="{x:Static app:Icons.Close}" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Disk space: the sizes are measured before anything is deleted, so the decision is made
             with the number in front of it. -->
        <StackPanel Spacing="10">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="{loc:T SpaceTitle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding ScanSpaceCommand}">
              <StackPanel Classes="iconLabel">
                <Path Classes="icon" Data="{x:Static app:Icons.Refresh}" />
                <TextBlock Text="{loc:T SpaceScan}" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Classes="card" Padding="6,6">
            <StackPanel Spacing="2">

              <TextBlock Classes="stat" TextWrapping="Wrap" Margin="10,4,10,6" Text="{loc:T SpaceIntro}" />

              <ItemsControl ItemsSource="{Binding SpaceItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpaceItem">
                    <Border Classes="item" Classes.running="{Binding IsWorking}" Margin="0,0,0,2"
                            ToolTip.Tip="{Binding Where}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                          <CheckBox IsChecked="{Binding IsOn}" IsEnabled="{Binding IsSupported}"
                                    Content="{Binding Title}" />
                          <TextBlock Classes="stat" Margin="28,0,0,0" TextWrapping="Wrap"
                                     Text="{Binding Explain}" />
                          <TextBlock Classes="outcome" Classes.bad="{Binding OutcomeIsBad}"
                                     Classes.pending="{Binding IsWorking}"
                                     Margin="28,0,0,0"
                                     IsVisible="{Binding Outcome, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Text="{Binding Outcome}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="size" Classes.empty="{Binding IsEmpty}"
                                   Text="{Binding SizeText}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="{DynamicResource Line}" Margin="10,6" />

              <Grid ColumnDefinitions="*,Auto" Margin="10,2,4,4">
                <TextBlock Grid.Column="0" Classes="stat" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,12,0" Text="{Binding SpaceStatus}" />
                <Button Grid.Column="1" Classes="go" Command="{Binding FreeSpaceCommand}">
                  <StackPanel Classes="iconLabel">
                    <Path Classes="icon" Data="{x:Static app:Icons.Delete}" />
                    <TextBlock Text="{Binding SpaceFreeLabel}" />
                  </StackPanel>
                </Button>
              </Grid>

            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Automatic clean: off unless asked for, and hemmed in by a threshold, a gap and
             idleness, so it cannot turn into a cleaner that runs every two seconds. -->
        <StackPanel Spacing="10">

          <TextBlock Classes="section" Text="{loc:T MemAutoTitle}" />

          <Border Classes="card">
            <StackPanel Spacing="10">
              <WrapPanel>
                <CheckBox IsChecked="{Binding AutoClean}" Content="{loc:T MemAutoOn}" Margin="0,0,10,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding AutoThreshold}" Minimum="50" Maximum="99" Increment="5"
                                 IsEnabled="{Binding AutoClean}" />
                  <TextBlock Classes="stat" VerticalAlignment="Center" Text="%" />
                </StackPanel>
              </WrapPanel>
              <WrapPanel Margin="28,0,0,0" IsEnabled="{Binding AutoClean}">
                <TextBlock Classes="stat" VerticalAlignment="Center" Margin="0,0,10,0" Text="{loc:T MemAutoCooldown}" />
                <NumericUpDown Value="{Binding AutoCooldownMinutes}" Minimum="1" Maximum="1440" Increment="5" />
                <TextBlock Classes="stat" VerticalAlignment="Center" Margin="10,0,0,0" Text="{loc:T MemAutoMinutes}" />
              </WrapPanel>
              <WrapPanel Margin="28,0,0,0" IsEnabled="{Binding AutoClean}">
                <CheckBox IsChecked="{Binding AutoWhenIdle}" Content="{loc:T MemAutoIdle}" Margin="0,0,10,0" />
                <NumericUpDown Value="{Binding AutoIdleSeconds}" Minimum="10" Maximum="3600" Increment="10"
                               IsEnabled="{Binding AutoWhenIdle}" />
                <TextBlock Classes="stat" VerticalAlignment="Center" Margin="10,0,0,0" Text="{loc:T MemAutoSeconds}" />
              </WrapPanel>
              <TextBlock Classes="stat" TextWrapping="Wrap" Text="{loc:T MemAutoNote}" />
              <TextBlock Classes="outcome" Text="{Binding AutoStatus}"
                         IsVisible="{Binding AutoStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource Panel}" Padding="22,14"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center"
                   Text="{Binding Status}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMuted}" />
        <Button Grid.Column="1" Classes="go" VerticalAlignment="Center"
 Command="{Binding CleanCommand}">
          <StackPanel Classes="iconLabel">
            <Path Classes="icon" Data="{x:Static app:Icons.Sparkle}" />
            <TextBlock Text="{Binding CleanLabel}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

  </Grid>
</UserControl>
