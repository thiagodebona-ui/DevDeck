<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DevDeck.App.Localisation"
             xmlns:vm="using:DevDeck.App.ViewModels"
             xmlns:core="using:DevDeck.Core"
             xmlns:views="using:DevDeck.App.Views"
             x:Class="DevDeck.App.Views.ToolboxView"
             x:DataType="vm:ToolboxViewModel">

  <UserControl.Styles>

    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource SteelRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SteelHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Steel}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style Selector="TextBox.pad">
      <Setter Property="Background" Value="{DynamicResource Ink}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style Selector="ListBox.tools">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.tools ListBoxItem">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ListBox.tools ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SteelRaised}" />
    </Style>

    <!-- The tool glyph: stroked, the weight of the text beside it, brass on the chosen row - the
         same treatment the rail gives its own icons. -->
    <Style Selector="Path.toolIcon">
      <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBox.tools ListBoxItem:selected Path.toolIcon">
      <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Text and Tree: two halves of one switch, the current one lit. -->
    <Style Selector="Button.seg">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="Button.seg.first">
      <Setter Property="CornerRadius" Value="2,0,0,2" />
    </Style>

    <Style Selector="Button.seg.last">
      <Setter Property="CornerRadius" Value="0,2,2,0" />
      <Setter Property="BorderThickness" Value="0,1,1,1" />
    </Style>

    <Style Selector="Button.seg.on">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource SteelRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

  </UserControl.Styles>

  <Grid ColumnDefinitions="188,*">

    <!-- The tools, grouped, down the side. A list rather than a dropdown because the answer to
         "what can this do" should be visible without a click. -->
    <Border Grid.Column="0" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">

        <TextBlock DockPanel.Dock="Bottom" Margin="14,10,14,14"
                   Classes="label" TextWrapping="Wrap" LineHeight="15"
                   Text="{loc:T ToolboxEverythingHereRunsOnThisMachine}" />

        <ListBox Classes="tools"
                 ItemsSource="{Binding Tools}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:Tool">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                <Path Grid.Column="0" Classes="toolIcon" Data="{Binding Icon}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Text}" />
                <TextBlock Grid.Column="2" Text="{Binding Group}" FontSize="10"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFaint}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1" Margin="20" LastChildFill="True">

      <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,14">
        <TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text}" />
        <TextBlock Text="{Binding Selected.Hint}" Classes="label" TextWrapping="Wrap"
                   IsVisible="{Binding Selected.Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- The controls that only some tools need. Each appears for its own tool rather than being
           shown greyed out, so the panel is only ever as complicated as the job in front of it. -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">

        <ComboBox ItemsSource="{Binding Algorithms}"
                  SelectedItem="{Binding Algorithm, Mode=TwoWay}"
                  IsVisible="{Binding Selected.NeedsAlgorithm}" />

        <ComboBox ItemsSource="{Binding Cases}"
                  SelectedItem="{Binding Casing, Mode=TwoWay}"
                  IsVisible="{Binding Selected.NeedsCase}" />

        <Button Content="{loc:T ToolboxAgain}" Command="{Binding AgainCommand}"
                IsVisible="{Binding Selected.Generates}" />

        <Button Content="{loc:T ToolboxPaste}" Command="{Binding PasteInCommand}"
                IsVisible="{Binding !Selected.Generates}" />

        <Button Content="{loc:T Clear}" Command="{Binding ClearCommand}"
                IsVisible="{Binding !Selected.Generates}" />

        <TextBlock Text="{Binding Statistics}" Classes="label" VerticalAlignment="Center"
                   Margin="4,0,0,0" />
      </StackPanel>

      <TextBox DockPanel.Dock="Top" Classes="pad" Height="34" Margin="0,0,0,10"
               AcceptsReturn="False"
               Text="{Binding Pattern, Mode=TwoWay}"
               PlaceholderText="{loc:T ToolboxThePattern}"
               IsVisible="{Binding Selected.NeedsPattern}" />

      <Grid RowDefinitions="*,Auto,*">

        <TextBox Grid.Row="0" Classes="pad"
                 Text="{Binding Input, Mode=TwoWay}"
                 PlaceholderText="{loc:T ToolboxPasteHere}"
                 IsVisible="{Binding !Selected.Generates}" />

        <!-- A generator has no input, so the output takes the whole area rather than leaving an
             empty box above it. -->
        <Panel Grid.Row="0" IsVisible="{Binding Selected.Generates}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,10">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding Error}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource Warn}"
                       IsVisible="{Binding HasError}" />
            <TextBlock Text="{Binding Status}" Classes="label"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <!-- For the tools whose answer is a JSON document: read it as text, or open it up as a
               tree and collapse what is not wanted. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0"
                      IsVisible="{Binding Selected.HasTree}">
            <Button Classes="seg first" Classes.on="{Binding !TreeChosen}"
                    Content="{loc:T ToolboxText}" Command="{Binding ShowTextCommand}" />
            <Button Classes="seg last" Classes.on="{Binding TreeChosen}"
                    Content="{loc:T ToolboxTree}" ToolTip.Tip="{loc:T ToolboxTreeTip}"
                    Command="{Binding ShowTreeCommand}" />
          </StackPanel>

          <Button Grid.Column="2" Content="{loc:T ToolboxUseAsInput}" Margin="0,0,8,0"
                  Command="{Binding ChainCommand}"
                  IsVisible="{Binding !Selected.Generates}" />

          <Button Grid.Column="3" Content="{loc:T Copy}" Command="{Binding CopyOutCommand}" />

        </Grid>

        <TextBox Grid.Row="2" Classes="pad" IsReadOnly="True"
                 Text="{Binding Output}"
                 IsVisible="{Binding ShowingPlainText}" />

        <!-- JSON and XML come out coloured, as the HTTP panel shows a response: a formatted
             document in flat monospace leaves the eye to find the structure on its own. -->
        <views:BodyView Grid.Row="2"
                        Text="{Binding Output}"
                        Kind="{Binding Selected.OutputKind}"
                        IsVisible="{Binding ShowingStructuredText}" />

        <views:JsonTreeView Grid.Row="2"
                            Document="{Binding Tree}"
                            EmptyText="{Binding TreeNote}"
                            IsVisible="{Binding ShowingTree}" />

        <!-- The regex tool answers with a list of matches rather than one string, which is the one
             place the shared shape does not fit. -->
        <Border Grid.Row="2" Background="{DynamicResource Ink}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="2"
                IsVisible="{Binding Selected.NeedsPattern}">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Matches}" Margin="10">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontFamily="{DynamicResource MonoFont}"
                             FontSize="12" Foreground="{DynamicResource Text}"
                             Margin="0,0,0,3" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

      </Grid>

    </DockPanel>

  </Grid>
</UserControl>
