<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:DevDeck.App.Localisation"
        xmlns:vm="using:DevDeck.App.ViewModels"
        xmlns:views="using:DevDeck.App.Views"
        x:Class="DevDeck.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1080" Height="700"
        MinWidth="820" MinHeight="520"
        Background="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}"
        Icon="/Assets/DevDeck.ico">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:CommandsViewModel">
      <views:CommandsView />
    </DataTemplate>
    <DataTemplate DataType="vm:AssistantViewModel">
      <views:AssistantView />
    </DataTemplate>
    <DataTemplate DataType="vm:HttpViewModel">
      <views:HttpView />
    </DataTemplate>
    <DataTemplate DataType="vm:ToolboxViewModel">
      <views:ToolboxView />
    </DataTemplate>
    <DataTemplate DataType="vm:RunningViewModel">
      <views:RunningView />
    </DataTemplate>
    <DataTemplate DataType="vm:AutomationViewModel">
      <views:AutomationView />
    </DataTemplate>
    <DataTemplate DataType="vm:ClipsViewModel">
      <views:ClipsView />
    </DataTemplate>
    <DataTemplate DataType="vm:LogViewModel">
      <views:LogView />
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryViewModel">
      <views:MemoryView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:ChangelogViewModel">
      <views:ChangelogView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>

    <!-- The rail. A brass edge marks the active section; nothing else in the rail carries colour,
         so the eye finds the current place in one movement. -->
    <Style Selector="ListBox.rail">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.rail ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="edge"
                  Background="{TemplateBinding Background}"
                  BorderBrush="Transparent"
                  BorderThickness="3,0,0,0">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="14,9" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="ListBox.rail ListBoxItem:pointerover /template/ Border#edge">
      <Setter Property="Background" Value="{DynamicResource Steel}" />
    </Style>

    <Style Selector="ListBox.rail ListBoxItem:selected /template/ Border#edge">
      <Setter Property="Background" Value="{DynamicResource Steel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <!-- The same ring the deck list uses for a running command, at the same size and speed, so
         that "something is running over there" and "this is the thing running" read as one fact
         rather than two unrelated marks. -->
    <Style Selector="Ellipse.working">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource Accent}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeDashArray" Value="3,3" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>

    <Style Selector="Ellipse.working.turning">
      <Style.Animations>
        <Animation Duration="0:0:1.1" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.railName">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style Selector="ListBoxItem:selected TextBlock.railName">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <!-- The rail glyph. Stroked rather than filled, at the same weight as the text beside it, so
         a row reads as one thing rather than as a picture with a caption. It follows the name's
         colour exactly: muted normally, full strength on the row you are on. -->
    <Style Selector="Path.railIcon">
      <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBoxItem:selected Path.railIcon">
      <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover Path.railIcon">
      <Setter Property="Stroke" Value="{DynamicResource Text}" />
    </Style>

  </Window.Styles>

  <Grid ColumnDefinitions="212,*">

    <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,18" Spacing="1">
          <TextBlock Text="DevDeck" FontSize="19" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" />
          <TextBlock Text="{Binding Title}" FontSize="11.5"
                     Foreground="{DynamicResource TextFaint}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="18,14,18,16"
                   Text="{Binding Platform}" FontSize="10.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFaint}" />

        <ListBox Classes="rail"
                 ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding Selected}"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:Section">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                <Path Grid.Column="0" Classes="railIcon" Data="{Binding Icon}" />
                <TextBlock Grid.Column="1" Classes="railName" Text="{Binding Title}"
                           VerticalAlignment="Center" />
                <!-- A dot, not a word: it marks the sections that are still empty without
                     turning the rail into a status report. -->
                <Ellipse Grid.Column="2" Width="5" Height="5"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource TextFaint}"
                         IsVisible="{Binding !IsBuilt}" />

                <!-- And the other end of the same idea: a section with work going on in it says
                     so, wherever you happen to be looking. A chain runs its steps on the Commands
                     panel while you are watching the Automation panel, and without this the only
                     sign that anything at all was happening was a status line on the chain. -->
                <Ellipse Grid.Column="2" Classes="working turning"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{loc:T NavSectionBusy}"
                         IsVisible="{Binding IsBusy}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>
    </Border>

    <!-- The last fallback for a finished run nobody was watching: a strip across the top of
         whatever panel is open, dismissed by pressing it. It says nothing while there is nothing
         to say, so it costs no space in the ordinary case. -->
    <DockPanel Grid.Column="1" LastChildFill="True">

      <Button DockPanel.Dock="Top"
              IsVisible="{Binding HasAnnouncement}"
              Command="{Binding DismissCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Background="{DynamicResource AccentSoft}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
              CornerRadius="0" Padding="16,9">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding Announcement}" FontSize="12"
                     Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
          <TextBlock Text="{loc:T MainWindowDismiss}" FontSize="10.5"
                     Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

    <ContentControl Content="{Binding Selected}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:Section">
          <Panel>

            <ContentControl Content="{Binding Content}" IsVisible="{Binding IsBuilt}" />

            <!-- An empty section says what will go here and why it is empty. -->
            <StackPanel IsVisible="{Binding !IsBuilt}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="420" Spacing="10">
              <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMuted}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Blurb}" TextWrapping="Wrap" FontSize="13"
                         LineHeight="20" TextAlignment="Center"
                         Foreground="{DynamicResource TextFaint}" />
            </StackPanel>

          </Panel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    </DockPanel>

  </Grid>
</Window>
