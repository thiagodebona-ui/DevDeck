<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:DevDeck.Core"
             xmlns:views="using:DevDeck.App.Views"
             x:Class="DevDeck.App.Views.BodyView">

  <Border Background="{DynamicResource CodeBg}"
          BorderBrush="{DynamicResource Line}" BorderThickness="1"
          CornerRadius="2">

    <Panel>

      <!-- Shown only while there is nothing to show. A read-only pane has no watermark of its
           own, and an empty bordered box says less than a sentence does. -->
      <TextBlock Name="Empty" Margin="12,10"
                 FontSize="12"
                 Foreground="{DynamicResource TextFaint}"
                 VerticalAlignment="Top" />

      <!-- One row per line, and only the rows in view exist: see BodyLines for why the body is
           not one text block any more. Each row is selectable on its own; Copy above the pane
           takes the whole body. -->
      <ScrollViewer Name="Scroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Padding="12,10">
        <ItemsControl Name="Lines">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:BodyLine">
              <SelectableTextBlock views:BodyLineText.Line="{Binding}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="{Binding $parent[views:BodyView].BodyFontSize}"
                                   Foreground="{DynamicResource Text}"
                                   TextWrapping="NoWrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Panel>
  </Border>
</UserControl>
