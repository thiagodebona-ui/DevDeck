<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DevDeck.App.Localisation"
             xmlns:vm="using:DevDeck.App.ViewModels"
             xmlns:views="using:DevDeck.App.Views"
             xmlns:app="using:DevDeck.App"
             x:Class="DevDeck.App.Views.ChangelogView"
             x:DataType="vm:ChangelogViewModel">

  <UserControl.Styles>

    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource SteelRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SteelHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The mark beside a change: a star on an accent tint for something new, a tick on a green
         one for a repair. Tinted squares rather than bare glyphs, so the column of them reads as a
         list at a glance. -->
    <Style Selector="Border.mark">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{DynamicResource SteelRaised}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <Style Selector="Border.mark Path">
      <Setter Property="Stroke" Value="{DynamicResource Accent}" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.mark.fix Path">
      <Setter Property="Stroke" Value="{DynamicResource Good}" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="22,16,22,14"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="{loc:T NavChangelog}" FontSize="17" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" />
          <TextBlock Classes="note" Text="{Binding Version}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding CheckCommand}">
            <StackPanel Classes="iconLabel">
              <Path Classes="icon" Data="{x:Static app:Icons.Refresh}" />
              <TextBlock Text="{loc:T ChangelogCheck}" />
            </StackPanel>
          </Button>
          <Button IsVisible="{Binding HasUpdate}"
                  Command="{Binding GetUpdateCommand}"
                  Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"
                  BorderThickness="0">
            <StackPanel Classes="iconLabel">
              <Path Classes="icon" Data="{x:Static app:Icons.External}" />
              <TextBlock Text="{loc:T SettingsOpenTheReleasePage}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="22,20">
      <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">

        <TextBlock Classes="note" Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Classes="note" Text="{loc:T ChangelogEmpty}" IsVisible="{Binding IsEmpty}" />

        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChangelogRow">
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                      BorderThickness="1" CornerRadius="6" Margin="0,0,0,14">
                <StackPanel>

                  <!-- The version, what it is to this install, and when it came out. -->
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Margin="18,14,18,12">
                    <TextBlock Grid.Column="0" Text="{Binding Version}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" IsVisible="{Binding HasBadge}" Background="{DynamicResource Accent}"
                            CornerRadius="9" Padding="9,2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource OnAccent}" />
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" IsVisible="{Binding HasReleased}">
                      <Path Classes="icon" Data="{x:Static app:Icons.Calendar}"
                            Stroke="{DynamicResource TextFaint}" />
                      <TextBlock Text="{Binding ReleasedText}" FontSize="11.5"
                                 Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>

                  <Border Height="1" Background="{DynamicResource Line}" />

                  <!-- One row per change: its mark, its bold lead-in, and the explanation under it. -->
                  <ItemsControl ItemsSource="{Binding Lines}" Margin="18,14,18,4">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChangeLine">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,14">
                          <Border Grid.Column="0" Classes="mark" Classes.fix="{Binding IsFix}">
                            <Path Data="{Binding Icon}" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <SelectableTextBlock IsVisible="{Binding HasTitle}" FontSize="13"
                                                 FontWeight="SemiBold" TextWrapping="Wrap"
                                                 Foreground="{DynamicResource Text}"
                                                 views:MarkdownText.Markdown="{Binding Title}" />
                            <SelectableTextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                                 Foreground="{DynamicResource TextMuted}"
                                                 views:MarkdownText.Markdown="{Binding Body}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
