<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DevDeck.App.Localisation"
             xmlns:vm="using:DevDeck.App.ViewModels"
             x:Class="DevDeck.App.Views.ChangelogView"
             x:DataType="vm:ChangelogViewModel">

  <UserControl.Styles>

    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource SteelRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SteelHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="22,16,22,14"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="{loc:T NavChangelog}" FontSize="17" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" />
          <TextBlock Classes="note" Text="{Binding Version}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{loc:T ChangelogCheck}" Command="{Binding CheckCommand}" />
          <Button Content="{loc:T SettingsOpenTheReleasePage}" IsVisible="{Binding HasUpdate}"
                  Command="{Binding GetUpdateCommand}"
                  Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"
                  BorderThickness="0" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="22,20">
      <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">

        <TextBlock Classes="note" Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Classes="note" Text="{loc:T ChangelogEmpty}" IsVisible="{Binding IsEmpty}" />

        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChangelogRow">
              <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                      BorderThickness="1" CornerRadius="4" Padding="18,14" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Version}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding HasBadge}" Background="{DynamicResource Accent}"
                            CornerRadius="2" Padding="7,2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Badge}" FontSize="10.5"
                                 Foreground="{DynamicResource OnAccent}" />
                    </Border>
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding Notes}" FontSize="12" TextWrapping="Wrap"
                                       LineHeight="19" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
