<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:DevDeck.App.Localisation"
        xmlns:app="using:DevDeck.App"
        x:Class="DevDeck.App.Views.ConfirmPrompt"
        Title="{loc:T ConfirmTitle}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource Ink}">

  <Window.Styles>

    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource SteelRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="16,7" />
    </Style>

    <!-- The dangerous button is the one that stands out, not the safe one. This dialog is only
         ever shown for something irreversible, and a user who is clicking through it out of habit
         should be looking at a red button rather than a brass one. -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource Bad}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Bad}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto">

    <StackPanel Grid.Row="0" Margin="20,18" Spacing="10">
      <TextBlock x:Name="Heading" FontSize="14" FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource Text}" />
      <TextBlock x:Name="Detail" FontSize="12"
                 TextWrapping="Wrap" LineHeight="18"
                 Foreground="{DynamicResource TextMuted}" />
    </StackPanel>

    <Border Grid.Row="1" Padding="20,14" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <!-- Cancel is the default, so that Enter on a dialog nobody read does nothing. -->
        <Button Click="CancelClick" IsDefault="True" IsCancel="True">
          <StackPanel Classes="iconLabel">
            <Path Classes="icon" Data="{x:Static app:Icons.Close}" />
            <TextBlock Text="{loc:T Cancel}" />
          </StackPanel>
        </Button>
        <Button x:Name="Go" Classes="danger" Click="AcceptClick">
          <StackPanel Classes="iconLabel">
            <Path Classes="icon" Data="{x:Static app:Icons.Check}" />
            <TextBlock x:Name="GoLabel" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

  </Grid>
</Window>
