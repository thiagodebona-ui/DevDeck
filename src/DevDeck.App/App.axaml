<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DevDeck.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <!-- The one style every icon in the app is drawn with, kept here rather than repeated in each
         panel so that the set stays one set: same size, same weight, same joins, everywhere.

         Stroke follows the foreground of whatever it sits in rather than naming a colour. That is
         what makes one style enough for both kinds of button: on an ordinary one the glyph is the
         text colour, and on the brass Run button it is the colour the label already is, without
         either of them knowing about the other. It also means a theme change carries the icons
         with it for free. -->
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The handful that read as a shape rather than as an outline. A play triangle or a stop
         square drawn as a hollow outline at 16 points is a smudge; filled, both are unmistakable. -->
    <Style Selector="Path.icon.solid">
      <Setter Property="Fill" Value="{Binding $parent[TemplatedControl].Foreground}" />
      <Setter Property="Stroke" Value="{x:Null}" />
    </Style>

    <!-- Icon beside label, at the spacing that reads as one control rather than two. -->
    <Style Selector="StackPanel.iconLabel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="7" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>

      <!-- Slot zero is the palette, and ThemeManager swaps it whole when the theme changes. The
           value here is only the one the designer and the first frame use; App.axaml.cs replaces
           it with the saved theme before the window is shown.

           Everything that reads these keys does so with DynamicResource. StaticResource resolves
           once at construction, which is exactly why the theme picker used to do nothing. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DevDeck/Themes/SteelDark.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <FontFamily x:Key="UiFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
      <!-- Consolas first, deliberately. Cascadia resolves to the ligature cut on this machine, which
           draws a double dash in a command line as one long dash. That is unreadable for text the
           user is meant to type back. -->
      <FontFamily x:Key="MonoFont">Consolas,Cascadia Mono,SF Mono,Menlo,DejaVu Sans Mono,monospace</FontFamily>

    </ResourceDictionary>
  </Application.Resources>

</Application>
