<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Steel Light: the same layout in daylight. The page is the tinted surface and the cards are
       white, which is the inverse of the dark theme - there, the page is darkest and the cards
       lift off it. Doing it the other way round in a light theme gives grey cards on a white page,
       which reads as disabled.

       The accent is darkened well past the dark theme's brass. #C8A15A on white is about 2:1
       against the page, so it fails as a text or border colour; this one carries white text. -->

  <SolidColorBrush x:Key="Ink" Color="#F2F5F8" />
  <SolidColorBrush x:Key="Panel" Color="#E7ECF2" />
  <SolidColorBrush x:Key="Steel" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SteelRaised" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SteelHover" Color="#E9EFF6" />
  <SolidColorBrush x:Key="Line" Color="#C7D2DF" />
  <SolidColorBrush x:Key="CodeBg" Color="#F7F9FC" />

  <SolidColorBrush x:Key="Text" Color="#1A222B" />
  <SolidColorBrush x:Key="TextMuted" Color="#515E6D" />
  <SolidColorBrush x:Key="TextFaint" Color="#78879A" />

  <SolidColorBrush x:Key="Accent" Color="#8A6414" />
  <SolidColorBrush x:Key="AccentSoft" Color="#A2782A" />
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

  <SolidColorBrush x:Key="Good" Color="#2C6E4F" />
  <SolidColorBrush x:Key="Bad" Color="#A93129" />
  <SolidColorBrush x:Key="Warn" Color="#7D5E00" />

  <SolidColorBrush x:Key="WidgetBg" Color="#FFFFFF" Opacity="0.94" />

  <SolidColorBrush x:Key="SynKeyword" Color="#1B4F9C" />
  <SolidColorBrush x:Key="SynString" Color="#276B33" />
  <SolidColorBrush x:Key="SynComment" Color="#7A8796" />
  <SolidColorBrush x:Key="SynNumber" Color="#7D5E00" />
  <SolidColorBrush x:Key="SynVariable" Color="#8A4A14" />

  <!-- The sunken track a progress bar is drawn into: always a step away from Ink,
       or the bar has no groove to sit in. -->
  <SolidColorBrush x:Key="Track" Color="#D8E0EA" />

</ResourceDictionary>
