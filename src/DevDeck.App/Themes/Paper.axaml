<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Paper: a warm light theme for a bright room. Terracotta rather than brass for the accent,
       because a yellow accent on a cream page has almost no contrast to spend. -->

  <SolidColorBrush x:Key="Ink" Color="#FAF7F2" />
  <SolidColorBrush x:Key="Panel" Color="#F1EBE1" />
  <SolidColorBrush x:Key="Steel" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SteelRaised" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SteelHover" Color="#F4EFE6" />
  <SolidColorBrush x:Key="Line" Color="#DDD4C6" />
  <SolidColorBrush x:Key="CodeBg" Color="#F5F1E8" />

  <SolidColorBrush x:Key="Text" Color="#2A2520" />
  <SolidColorBrush x:Key="TextMuted" Color="#655C51" />
  <SolidColorBrush x:Key="TextFaint" Color="#948A7C" />

  <SolidColorBrush x:Key="Accent" Color="#9B5A24" />
  <SolidColorBrush x:Key="AccentSoft" Color="#B26C31" />
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

  <SolidColorBrush x:Key="Good" Color="#356B47" />
  <SolidColorBrush x:Key="Bad" Color="#A03329" />
  <SolidColorBrush x:Key="Warn" Color="#8A6314" />

  <SolidColorBrush x:Key="WidgetBg" Color="#FFFFFF" Opacity="0.94" />

  <SolidColorBrush x:Key="SynKeyword" Color="#8A3E8F" />
  <SolidColorBrush x:Key="SynString" Color="#356B47" />
  <SolidColorBrush x:Key="SynComment" Color="#948A7C" />
  <SolidColorBrush x:Key="SynNumber" Color="#8A6314" />
  <SolidColorBrush x:Key="SynVariable" Color="#9B5A24" />

  <!-- The sunken track a progress bar is drawn into: always a step away from Ink,
       or the bar has no groove to sit in. -->
  <SolidColorBrush x:Key="Track" Color="#E8E0D4" />

</ResourceDictionary>
